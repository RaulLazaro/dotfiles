# GitHub Packages — @raullazaro scope
# Reads via SSH (no token needed), publish requires token with write:packages
@raullazaro:registry=https://npm.pkg.github.com
# For publishing, set token: npm config set //npm.pkg.github.com/:_authToken YOUR_TOKEN

# npm supply chain (https://github.com/lirantal/npm-security-best-practices)
# Node 22: use bundled npm 10.9.x — same line as typical CI/deploy, not npm 11 via corepack.

ignore-scripts=true
save-exact=true

# allow-git=root and min-release-age need npm >= 11.10; skip until you standardize on npm 11 everywhere.
